{
  "name": "@peak/server",
  "version": "2.0.0",
  "private": true,
  "description": "Express + MySQL API for the Peak Performance gym management system",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src src/index.js",
    "db:check": "node scripts/db-check.js",
    "user:create": "node scripts/create-user.js",
    "seed:demo-users": "node scripts/seed-demo-users.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
