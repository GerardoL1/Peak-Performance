# Copy to .env and fill in. NEVER commit .env.
# Use a dedicated least-privilege MySQL user, not root:
#   CREATE USER 'peak_app'@'localhost' IDENTIFIED BY '<long random password>';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON peakperformance.* TO 'peak_app'@'localhost';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=peak_app
DB_PASSWORD=
DB_NAME=peakperformance

SERVER_HOST=127.0.0.1
SERVER_PORT=5000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:3000
# Requests per IP per 15 minutes
RATE_LIMIT_MAX=600
# Failed sign-in attempts per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10

# Signs session tokens. Required, at least 32 characters, unique per environment.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a sign-in lasts (hours)
SESSION_HOURS=10
# bcrypt cost factor (12 is ~250ms per hash)
BCRYPT_ROUNDS=12
# Set to true when the site is served over HTTPS (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (0 locally, 1 behind nginx)
TRUST_PROXY=0
